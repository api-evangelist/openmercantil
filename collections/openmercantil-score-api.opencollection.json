{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenMercantil Public Billing Score API",
    "version": "1.4.0"
  },
  "items": [
    {
      "info": {
        "name": "Score",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Company Score",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openmercantil.es/api/v1/company/:slug/score",
            "params": [
              {
                "name": "slug",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Return the OpenMercantil composite company score (introduced in v1.1)."
        },
        {
          "info": {
            "name": "Get Company Activity Timeseries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openmercantil.es/api/v1/company/:slug/activity",
            "params": [
              {
                "name": "slug",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Return a time series of registry activity events for the company (v1.1)."
        },
        {
          "info": {
            "name": "Get Company Trust Score",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openmercantil.es/api/v1/company/:slug/trust-score",
            "params": [
              {
                "name": "slug",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Return the OpenMercantil trust score combining BORME, CNMV, OEPM, PLACSP, BOE and sanctions signals (v1.4)."
        }
      ]
    }
  ],
  "bundled": true
}